{
  "name": "time-website",
  "private": true,
  "type": "module",
  "description": "Automated checks for the TIME Inc. static website. The learning portal backend has its own package in backend/.",
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "test:backend": "npm --prefix backend test",
    "serve": "node tests/serve.mjs",
    "layout": "node scripts/layout.mjs",
    "programs": "node scripts/programs.mjs",
    "search": "node scripts/search-index.mjs",
    "assistant": "node scripts/assistant-knowledge.mjs"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "playwright": "1.63.0"
  }
}

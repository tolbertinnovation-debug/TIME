// TIME Learning database.
// Step 1: accounts, roles, the catalogue, approvals and the activity log.
// Step 2: intakes, study centres, classes, class staff and enrolments.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  LECTURER
  FACILITATOR // study centre facilitator
  REGISTRAR
  FINANCE
  LEADERSHIP // Dean, Executive Director
  ADMIN // system administrator
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// ---- Accounts (the first four models follow Better Auth's schema) ----

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  phone         String?
  role          Role       @default(STUDENT)
  status        UserStatus @default(ACTIVE)
  // Given once, when the person is first enrolled, e.g. "TIME-2027-0001"
  studentNumber String?    @unique
  county        String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions          Session[]
  accounts          Account[]
  activity          AuditLog[]
  approvalsMade     ApprovalRequest[] @relation("requester")
  approvalsDecided  ApprovalRequest[] @relation("decider")
  enrolments        Enrolment[]
  classStaff        ClassStaff[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---- Catalogue: School -> Program -> Course (imported from the website's data/catalogue.json) ----

model School {
  id      String   @id // slug, e.g. "teacher-education"
  title   String
  short   String
  blurb   String
  sort    Int      @default(0)
  courses Course[]

  @@map("school")
}

model Program {
  id      String   @id // slug, e.g. "c-certificate"
  title   String
  sort    Int      @default(0)
  courses Course[]

  @@map("program")
}

enum DeliveryMode {
  ONLINE
  BLENDED
  ON_CAMPUS
}

model Course {
  id                String       @id // slug
  title             String
  schoolId          String
  school            School       @relation(fields: [schoolId], references: [id])
  programId         String
  program           Program      @relation(fields: [programId], references: [id])
  duration          String?
  tuitionUsd        Int?
  installments      Int          @default(1)
  deliveryMode      DeliveryMode
  deliveryConfirmed Boolean      @default(false)
  active            Boolean      @default(true)
  sort              Int          @default(0)
  classes           CourseClass[]

  @@index([schoolId])
  @@index([programId])
  @@map("course")
}

// ---- Academic setup: intakes, study centres and classes ----

enum IntakeStatus {
  PLANNED // visible to staff only
  OPEN // students can apply
  CLOSED // applications have ended
}

model Intake {
  id         String        @id @default(cuid())
  name       String        @unique // e.g. "March 2027"
  startDate  DateTime      @db.Date
  registerBy DateTime?     @db.Date
  status     IntakeStatus  @default(PLANNED)
  classes    CourseClass[]

  @@map("intake")
}

model StudyCentre {
  id      String        @id @default(cuid())
  name    String        @unique
  county  String
  address String?
  active  Boolean       @default(true)
  classes CourseClass[]

  @@map("study_centre")
}

enum Track {
  WEEKDAY
  SATURDAY
}

enum ClassStatus {
  OPEN
  CLOSED
}

// A class is one running of a course: an intake, a schedule and a way of studying.
model CourseClass {
  id            String       @id @default(cuid())
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id])
  intakeId      String
  intake        Intake       @relation(fields: [intakeId], references: [id])
  track         Track
  mode          DeliveryMode
  studyCentreId String?
  studyCentre   StudyCentre? @relation(fields: [studyCentreId], references: [id])
  capacity      Int?
  status        ClassStatus  @default(OPEN)
  createdAt     DateTime     @default(now())
  staff         ClassStaff[]
  enrolments    Enrolment[]

  @@unique([courseId, intakeId, track])
  @@index([intakeId])
  @@map("course_class")
}

enum ClassStaffRole {
  LECTURER
  FACILITATOR
}

model ClassStaff {
  classId String
  class   CourseClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId  String
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    ClassStaffRole

  @@id([classId, userId])
  @@index([userId])
  @@map("class_staff")
}

enum EnrolmentStatus {
  ACTIVE
  WITHDRAWN
  DEFERRED
  COMPLETED
}

model Enrolment {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId    String
  class      CourseClass     @relation(fields: [classId], references: [id])
  status     EnrolmentStatus @default(ACTIVE)
  enrolledAt DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([userId, classId])
  @@index([classId, status])
  @@map("enrolment")
}

// ---- Approvals: one inbox for every decision that needs sign-off ----

enum ApprovalType {
  STAFF_ACCESS // a person asks for a staff role
  APPLICATION // a student applies to join a class
  ENROLMENT_CHANGE // an enrolled student asks to withdraw or defer
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRequest {
  id            String         @id @default(cuid())
  type          ApprovalType
  status        ApprovalStatus @default(PENDING)
  requestedById String
  requestedBy   User           @relation("requester", fields: [requestedById], references: [id], onDelete: Cascade)
  // What is being asked for, e.g. { "role": "LECTURER" }
  payload       Json
  note          String?
  decidedById   String?
  decidedBy     User?          @relation("decider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime       @default(now())

  @@index([status, createdAt])
  @@index([requestedById])
  @@map("approval_request")
}

// ---- Activity log: who did what, when. Rows are only ever added. ----

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // Kept even if the account is later removed
  actorLabel String
  action     String // e.g. "user.role_changed"
  entityType String?
  entityId   String?
  summary    String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

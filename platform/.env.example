# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://time:time@localhost:5432/time_dev"
# A long random string: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
# The address people use to open the platform. On Vercel this can be left out: the live address is used.
BETTER_AUTH_URL="http://localhost:3000"
# Optional: the database's direct (non-pooled) address, used only for table changes.
# DIRECT_URL=""
# First live deployment only: the first administrator. Remove ADMIN_PASSWORD from the host afterwards.
# ADMIN_NAME=""
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
